# Server
PORT=3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Company context (WhatsApp bot belongs to one company)
DEFAULT_COMPANY_ID=your-company-uuid
# Optional — auto-resolved from company_members.owner if omitted
# DEFAULT_CREATED_BY=your-user-uuid

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_API_VERSION=v23.0

# Set to true to skip real Meta API calls (logs replies to console instead)
WHATSAPP_MOCK=false
